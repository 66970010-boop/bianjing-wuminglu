# Copy to .env. Keep this file on the server, never in frontend code.
OPENAI_API_KEY=
# Set the exact text model ID available to your API account.
OPENAI_MODEL=
PORT=3001
# Local use by default. Set HOST=0.0.0.0 only on your deployment server.
HOST=127.0.0.1
# One server process: global API calls per UTC day, including failures.
AI_DAILY_LIMIT=100
# Optional: public HTTPS origin when using a reverse proxy.
PUBLIC_ORIGIN=
